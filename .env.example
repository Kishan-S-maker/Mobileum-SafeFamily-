# Server Port
PORT=5000

# Excel Workbook Path (relative to project root)
EXCEL_PATH=./child_spam_alert_demo_data.xlsx

# SMTP Configuration for Real Email Alerts
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="SafeFamily Telecom Security" <noreply@telecom-security.com>

# Optional: Set to true to simulate delay in verification pipeline for visual demonstration
SIMULATION_STEP_DELAY_MS=300
